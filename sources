# Формат: тип:значение  (строки с # игнорируются)

# discover: — автопоиск свежих репозиториев на GitHub по ключевым словам.
# Если не указать ни одной строки, используются запросы по умолчанию (vless reality, v2ray configs,
# vpn configs russia, белые списки vless и т.д.). Свои запросы добавляй так:
#discover:vless reality sni

# repo: — взять все текстовые файлы конкретного репозитория (владелец/имя)
repo:igareck/vpn-configs-for-russia
repo:barry-far/V2ray-Config
